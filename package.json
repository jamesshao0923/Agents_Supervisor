{
  "name": "supervisor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": "24.20.0", "pnpm": "11.25.0" },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "pnpm build && node dist/tools/p0/cli.js boundaries",
    "doctor": "pnpm build && node dist/tools/p0/cli.js doctor",
    "test:unit": "pnpm build && node dist/tools/p0/cli.js run --layer unit",
    "test:integration": "pnpm build && node dist/tools/p0/cli.js run --layer integration",
    "test:live": "node tools/unavailable.mjs live",
    "verify:stage": "pnpm build && node dist/tools/p0/cli.js run",
    "verify:p0": "pnpm build && node dist/tools/p0/cli.js run --stage P0",
    "supervisor": "node dist/apps/cli/main.js",
    "verify:evidence": "node dist/tools/p0/cli.js check",
    "verify:release": "node tools/unavailable.mjs release"
  },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "6.0.3" }
}
